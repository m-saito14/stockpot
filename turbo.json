{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:int": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      // `^build` は付けない。Storybook は Vite で workspace パッケージの TS ソースを
      // 直接ビルドするため、依存パッケージのビルド成果物を使わない。
      // 付けると @stockpot/api#build（tsc）まで走り、Prisma Client 未生成で失敗する。
      "outputs": ["storybook-static/**"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
