    "@stockpot/shared": "workspace:*",
    "ai": "^4.0.0",
    "firebase-admin": "^13.0.0",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
