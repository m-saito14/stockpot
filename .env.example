# ── Database (Cloud SQL / ローカルは docker compose の Postgres) ──
DATABASE_URL="postgresql://stockpot:stockpot@localhost:5432/stockpot?schema=public"

# ── Firebase Authentication ──
# サーバー側 JWT 検証用（Admin SDK）。JSON 全体を 1 行にした文字列を推奨。
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# クライアント側（apps/web）。NEXT_PUBLIC_* はブラウザに露出する公開設定のみ。
# 秘密鍵（FIREBASE_PRIVATE_KEY）はここに置かない。
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── LLM (Vercel AI SDK) ──
# provider 非依存。model 定義で使うキーだけ設定する（設計書 §6）。
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# 開発時に LLM を叩かずスタブで動かす（設計書 §18.4）
USE_STUB_LLM="true"

# LLM 呼び出しタイムアウト（ミリ秒 / 設計書 §7）
LLM_TIMEOUT_MS="90000"

# ── Langfuse Cloud（観測 / 評価） ──
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASEURL="https://cloud.langfuse.com"

# ── API / Web ──
PORT="8080"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"
